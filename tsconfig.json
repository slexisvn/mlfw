  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": true,
    "allowJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "@webgpu/types"]
