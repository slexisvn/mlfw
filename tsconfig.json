{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src/compiler/ir/graph/types.ts",
    "src/util/**/*.ts",
    "src/dispatcher/**/*.ts",
    "src/tensor/types/**/*.ts",
    "src/tensor/core/**/*.ts",
    "src/tensor/utils/**/*.ts",
    "src/tensor/factory/**/*.ts",
    "src/tensor/ops/**/*.ts",
    "src/tensor/native/**/*.ts",
    "src/autograd/**/*.ts",
    "src/numeric/**/*.ts",
    "src/optim/**/*.ts",
    "src/tracing/**/*.ts",
    "src/nn/**/*.ts",
    "src/tokenizer/**/*.ts",
    "src/data/**/*.ts"
  ]
}
