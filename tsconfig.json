{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src/compiler/ir/graph/types.ts",
    "src/dispatcher/dispatch_key.ts",
    "src/dispatcher/boxing.ts",
    "src/dispatcher/library.ts",
    "src/dispatcher/jit_dispatch.ts",
    "src/tensor/types/**/*.ts",
    "src/tensor/core/**/*.ts",
    "src/tensor/utils/**/*.ts",
    "src/tensor/factory/from_ops.ts",
    "src/tensor/ops/linalg.ts",
    "src/numeric/**/*.ts"
  ]
}
