{
  "name": "mlc",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "mlfw": "./src/cli/index.js"
  },
  "scripts": {
    "start": "node src/cli/index.js",
    "test": "vitest run --exclude '**/node_modules/**' --exclude '**/stress/**' --exclude '**/webgpu-gpu.test.*' --exclude '**/vscode-ext/**'",
    "test:all": "vitest run",
    "build:vscode": "node vscode-ext/scripts/generate.js",
    "test:coverage": "vitest run --coverage",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.8",
    "patch-package": "^8.0.1",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "cli-highlight": "^2.1.11",
    "terminal-kit": "^3.1.2",
    "webgpu": "^0.4.0"
  }
}
