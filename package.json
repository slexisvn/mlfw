{
  "name": "@slexisvn/mlfw",
  "version": "0.1.4",
  "type": "module",
  "main": "./dist/index.node.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.js",
      "default": "./dist/index.node.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "imports": {
    "#io/fs": {
      "browser": "./src/runtime/browser/fs.js",
      "default": "./src/runtime/node/fs.js"
    },
    "#io/wasm_pool": {
      "browser": "./src/runtime/browser/wasm_pool.js",
      "default": "./src/runtime/node/wasm_pool.js"
    },
    "#io/cuda_runtime": {
      "browser": "./src/runtime/browser/cuda_runtime.js",
      "default": "./src/runtime/node/cuda_runtime.js"
    },
    "#io/cuda/*": {
      "browser": "./src/runtime/browser/cuda/*",
      "default": "./src/runtime/node/cuda/*"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --exclude '**/node_modules/**' --exclude '**/stress/**' --exclude '**/backend/cuda/**' --exclude '**/cuda-linalg.test.js' --exclude '**/backend/webgpu/**' --exclude '**/vscode-ext/**'",
    "test:webgpu": "vitest run tests/backend/webgpu/",
    "test:cuda": "vitest run tests/backend/cuda/ tests/linalg/cuda-linalg.test.js"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.28.0",
    "puppeteer-core": "^25.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "koffi": "^3.0.2",
    "webgpu": "^0.4.0"
  }
}
