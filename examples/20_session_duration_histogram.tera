sessions = DataFrame(
  duration_s=[12.0, 18.0, 22.0, 25.0, 31.0, 35.0, 38.0, 41.0, 44.0, 49.0,
              52.0, 58.0, 63.0, 67.0, 71.0, 78.0, 84.0, 92.0, 101.0, 118.0,
              14.0, 19.0, 27.0, 33.0, 37.0, 45.0, 55.0, 69.0, 88.0, 130.0],
  plan=["free", "free", "free", "free", "pro", "free", "pro", "free", "pro", "free",
        "pro", "free", "pro", "pro", "free", "pro", "pro", "pro", "pro", "pro",
        "free", "free", "free", "pro", "free", "pro", "free", "pro", "pro", "pro"]
)

labeled = sessions
  .withColumn("segment", expr("CASE WHEN duration_s >= 60 THEN 'engaged' ELSE 'casual' END"))

chart.histogram(labeled, x="duration_s", color="segment", bins=12, title="Session duration distribution by segment")
