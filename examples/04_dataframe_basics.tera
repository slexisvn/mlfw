
employees = DataFrame(
  name=["Alice", "Bob", "Carol", "Dan", "Eve", "Frank", "Grace", "Heidi"],
  dept=["Eng", "Eng", "Sales", "Sales", "Eng", "HR", "Sales", "HR"],
  salary=[120, 95, 80, 75, 110, 60, 90, 65],
  age=[34, 28, 41, 25, 38, 52, 30, 45],
)

print("columns:", employees.columns())
print("row count:", employees.count())
employees.show()

employees.select("name", "dept", "salary").show()
employees.drop("age").show()

with_bonus = employees.withColumn("bonus", col("salary").mul(lit(0.1)))
with_bonus.select("name", "salary", "bonus").show()

employees.filter(col("dept").eq("Eng")).show()
employees.where(col("salary").ge(90)).show()

employees.orderBy("salary").show()
employees.sort("age").limit(3).show()
employees.limit(2, 4).show()

employees.select("dept").distinct().orderBy("dept").show()

print("plan:")
print(employees.filter(col("salary").gt(100)).select("name").explain())

rows = employees.orderBy("name").to_array()
print("row count materialized:", rows.length)
print("first row:", rows[0])
