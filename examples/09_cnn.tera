
model SmallCNN(num_classes: int):
  conv1 = Conv2d(1, 8, 3, padding=1)
  bn1 = BatchNorm2d(8)
  conv2 = Conv2d(8, 16, 3, padding=1)
  bn2 = BatchNorm2d(16)
  pool = MaxPool2d(2)
  gap = AdaptiveAvgPool2d([1, 1])
  flat = Flatten()
  head = Linear(16, num_classes)

  forward (x: Tensor) -> Tensor:
    h = pool(bn1(conv1(x)).relu())
    h = pool(bn2(conv2(h)).relu())
    h = flat(gap(h))
    return head(h)

net = SmallCNN(10)

images = randn([4, 1, 28, 28])
logits = net(images)
probs = logits.softmax(axis=1)

print("=== CNN ===")
print("input:", images.shape, "-> logits:", logits.shape)
print("per-sample probability sums (~1):", probs.sum(axis=1))
print("predicted classes:", logits.argmax(axis=1))

compiled = compile(net, input=images, target=cpu)
print(compiled)
