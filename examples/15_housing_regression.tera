
houses = DataFrame(
  area=[50.0, 80.0, 60.0, 100.0, 75.0, 120.0, 45.0, 90.0, 70.0, 110.0, 55.0, 85.0, 65.0, 95.0, 130.0, 40.0],
  rooms=[2, 3, 2, 4, 3, 5, 1, 3, 3, 4, 2, 3, 2, 4, 5, 1],
  age_years=[10, 5, 15, 2, 8, 1, 20, 6, 12, 3, 18, 7, 14, 4, 1, 25],
  price=[125.0, 212.5, 137.5, 277.0, 198.0, 338.5, 80.0, 231.0, 182.0, 295.5, 123.0, 219.5, 149.0, 264.0, 358.5, 62.5],
)

x = normalize(houses.select("area", "rooms", "age_years").to_tensor())
price = houses.select("price").to_tensor()
y = price / 100.0

x_train, x_val = train_test_split(x, test_size=0.2)
y_train, y_val = train_test_split(y, test_size=0.2)

train_loader = DataLoader(TensorDataset(x_train, y_train), batch_size=8, shuffle=true)
val_loader = DataLoader(TensorDataset(x_val, y_val), batch_size=8)

model HousePricer():
  net = Sequential(Linear(3, 32), ReLU(), Linear(32, 16), ReLU(), Linear(16, 1))
  loss_fn = MSELoss()

  forward x:
    return net(x)

  train batch:
    a, b = batch
    loss = loss_fn(HousePricer(a), b)
    log("train_loss", loss, prog_bar=true)
    return loss

  validate batch:
    a, b = batch
    log("val_loss", loss_fn(HousePricer(a), b), prog_bar=true)

  optimizer:
    return Adam(HousePricer.parameters(), lr=0.005)

net = HousePricer()
Trainer(max_epochs=300, logger=false, enable_progress=false, enable_checkpointing=false).fit(net, train_loader, val_loader)

net.eval()
pred = net(x_val) * 100.0
mae = (pred - y_val * 100.0).abs().mean()
print("=== House price regression ===")
print("validation MAE (price units):", mae)
print("predicted:", pred)
print("actual   :", y_val * 100.0)
