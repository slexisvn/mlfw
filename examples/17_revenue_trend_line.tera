mrr = DataFrame(
  month=[1, 2, 3, 4, 5, 6, 1, 2, 3, 4, 5, 6, 1, 2, 3, 4, 5, 6],
  tier=["Basic", "Basic", "Basic", "Basic", "Basic", "Basic",
        "Pro", "Pro", "Pro", "Pro", "Pro", "Pro",
        "Enterprise", "Enterprise", "Enterprise", "Enterprise", "Enterprise", "Enterprise"],
  new_mrr=[12.0, 13.5, 14.2, 15.0, 16.1, 17.4,
           30.0, 33.0, 35.5, 39.0, 42.0, 46.5,
           80.0, 82.0, 88.0, 95.0, 103.0, 118.0],
  churn_mrr=[1.0, 1.2, 1.1, 1.4, 1.3, 1.5,
             3.0, 2.8, 3.4, 3.1, 3.6, 3.9,
             6.0, 5.5, 7.0, 6.4, 8.1, 7.7]
)

net = mrr
  .withColumn("net_mrr", expr("new_mrr - churn_mrr"))
  .orderBy("tier", "month")

chart.line(net, x="month", y="net_mrr", color="tier", title="Net MRR trend by plan tier")
