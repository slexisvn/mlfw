# DataFrame — Phân tích dữ liệu bán hàng
#
# Minh hoạ built-in DataFrame API: lọc, cột tính toán, gộp nhóm + tổng hợp,
# sắp xếp và join. DataFrame là lazy — kế hoạch truy vấn chỉ chạy khi gọi
# collect()/toArray()/count()/show()/chunks().
#
# Bảng được dựng từ các cột truyền theo named-argument (mỗi cột một mảng).

# --- Dữ liệu nguồn (in-memory) ---
sales = dataframe(
  region=["North", "North", "South", "South", "East", "East"],
  product=["Widget", "Gadget", "Widget", "Gizmo", "Gadget", "Gizmo"],
  units=[10, 4, 7, 12, 2, 9],
  revenue=[250.0, 180.0, 175.0, 600.0, 90.0, 450.0],
  cost=[120.0, 90.0, 84.0, 300.0, 50.0, 210.0],
)

print("=== Dữ liệu gốc ===")
print("Các cột:", sales.columns())
print("Tổng số dòng:", sales.count())
sales.show()

# --- Lọc + cột tính toán ---
# Giữ các dòng doanh thu > 150, thêm cột lợi nhuận và biên lợi nhuận.
high = sales.filter(col("revenue").gt(150))
high = high.withColumn("profit", col("revenue").sub(col("cost")))
high = high.withColumn("margin", expr("(revenue - cost) / revenue"))
analysis = high.select("region", "product", "revenue", "profit", "margin")

print("=== Doanh thu > 150 ===")
analysis.show()

# --- Gộp nhóm + tổng hợp theo khu vực ---
grouped = sales.groupBy("region")
by_region = grouped.agg(
  countStar().alias("orders"),
  sum("revenue").alias("total_revenue"),
  avg("units").alias("avg_units"),
  max("revenue").alias("max_order"),
)
by_region = by_region.orderBy("region")

print("=== Tổng hợp theo khu vực ===")
by_region.show()

# --- Join: thêm thông tin quản lý vùng ---
regions = dataframe(
  region=["North", "South", "East"],
  manager=["An", "Binh", "Cuong"],
  target=[500.0, 800.0, 400.0],
)

joined = by_region.join(regions, "region")
joined = joined.withColumn("vs_target", col("total_revenue").sub(col("target")))
report = joined.filter(col("vs_target").gt(0))
report = report.select("region", "manager", "total_revenue", "target", "vs_target")

print("=== Khu vực vượt chỉ tiêu ===")
report.show()

# --- Vài phép toán trên Column ---
premium = sales.filter(col("product").isin("Widget", "Gizmo"))
premium = premium.filter(col("revenue").between(200, 600))
premium = premium.select("product", "revenue")

print("=== Sản phẩm cao cấp (doanh thu 200–600) ===")
premium.show()

# --- Lấy kết quả ra mảng để xử lý tiếp ---
rows = analysis.collect()
print("Số dòng phân tích:", len(rows))
print("Dòng đầu tiên:", rows[0])
