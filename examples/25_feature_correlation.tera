housing = DataFrame(
  area_m2=[45.0, 60.0, 75.0, 90.0, 110.0, 130.0, 55.0, 80.0, 95.0, 120.0,
           50.0, 70.0, 100.0, 140.0, 65.0],
  rooms=[2.0, 2.0, 3.0, 3.0, 4.0, 5.0, 2.0, 3.0, 4.0, 4.0,
         2.0, 3.0, 4.0, 5.0, 3.0],
  age_years=[30.0, 22.0, 15.0, 18.0, 8.0, 5.0, 25.0, 12.0, 10.0, 6.0,
             28.0, 20.0, 9.0, 3.0, 16.0],
  dist_center_km=[2.0, 3.5, 1.2, 4.0, 0.8, 0.5, 5.0, 2.5, 1.5, 0.9,
                  6.0, 3.0, 1.0, 0.4, 2.2],
  price_k=[120.0, 150.0, 210.0, 240.0, 330.0, 420.0, 130.0, 220.0, 290.0, 380.0,
           115.0, 180.0, 310.0, 470.0, 175.0]
)

enriched = housing
  .withColumn("price_per_m2", expr("CAST(price_k AS DOUBLE) * 1000 / area_m2"))

chart.correlation(enriched, method="pearson", title="Housing feature correlation")
