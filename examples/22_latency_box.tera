requests = DataFrame(
  tier=["free", "free", "free", "free", "free", "free", "free", "free",
        "pro", "pro", "pro", "pro", "pro", "pro", "pro", "pro",
        "enterprise", "enterprise", "enterprise", "enterprise",
        "enterprise", "enterprise", "enterprise", "enterprise"],
  latency_ms=[180.0, 220.0, 195.0, 240.0, 210.0, 600.0, 205.0, 230.0,
              90.0, 110.0, 95.0, 130.0, 105.0, 120.0, 99.0, 410.0,
              40.0, 55.0, 48.0, 62.0, 51.0, 58.0, 44.0, 70.0]
)

served = requests.filter("latency_ms > 0")

chart.box(served, x="latency_ms", color="tier", title="Response latency by service tier")
