
model SelfAttention(d: int):
  wq = Linear(d, d)
  wk = Linear(d, d)
  wv = Linear(d, d)
  wo = Linear(d, d)
  ln = LayerNorm([d])

  forward (x: Tensor) -> Tensor:
    q = wq(x)
    k = wk(x)
    v = wv(x)
    scale = tensor(d, dtype=f32).sqrt()
    attn = ((q @ k.transpose(0, 1)) / scale).softmax()
    return ln(x + wo(attn @ v))

model FeedForward(d: int):
  up = Linear(d, d * 4)
  down = Linear(d * 4, d)
  ln = LayerNorm([d])

  forward (x: Tensor) -> Tensor:
    return ln(x + down(up(x).gelu()))

model EncoderBlock(d: int):
  attn = SelfAttention(d)
  ffn = FeedForward(d)

  forward (x: Tensor) -> Tensor:
    return ffn(attn(x))

d = 32
embed = Embedding(100, d)
block = EncoderBlock(d)

tokens = tensor([3, 15, 42, 7, 0, 99], dtype=i32)
x = embed(tokens)
out = block(x)
print("=== Transformer encoder ===")
print("tokens:", tokens.shape, "-> embed:", x.shape, "-> out:", out.shape)

model CrossAttention(d: int):
  wq = Linear(d, d)
  wk = Linear(d, d)
  wv = Linear(d, d)

  forward (query: Tensor, context: Tensor) -> Tensor:
    q = wq(query)
    k = wk(context)
    v = wv(context)
    return (q @ k.transpose(0, 1)).softmax() @ v

cross = CrossAttention(d)
y = cross(randn([4, d]), randn([6, d]))
print("cross-attention:", y.shape)

compile(block, input=randn([8, d]), target=cpu)
print("compiled encoder ok")
