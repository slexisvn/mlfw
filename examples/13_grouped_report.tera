# Data problem: build an aggregated report, then post-process the result.
# Aggregate in the DataFrame, materialize with collect(), and compute shares and
# the top group in plain tera using row.field access.

orders = DataFrame(
  region=["N", "N", "S", "E", "S", "N", "E", "S", "N", "E", "S", "N"],
  category=["book", "toy", "book", "game", "toy", "game", "book", "toy", "game", "book", "game", "toy"],
  qty=[2, 1, 3, 1, 5, 2, 4, 2, 1, 6, 3, 2],
  price=[12.0, 25.0, 9.0, 40.0, 15.0, 30.0, 12.0, 18.0, 45.0, 9.0, 28.0, 22.0],
)
orders = orders.withColumn("revenue", col("qty").mul(col("price")))

by_cat = orders.groupBy("category").agg(
  sum("revenue").alias("revenue"),
  countStar().alias("orders"),
)
rows = by_cat.orderBy("category").collect()

# Grand total computed over the materialized rows
total = 0.0
for r in rows:
  total += r.revenue
print("grand total revenue:", total)

# Per-group share of total, and track the top group along the way
print("category | revenue | orders | share %")
top_name = ""
top_rev = 0.0
for r in rows:
  share = r.revenue / total * 100.0
  print(r.category, "|", r.revenue, "|", r.orders, "|", share)
  if r.revenue > top_rev:
    top_rev = r.revenue
    top_name = r.category

print("top category:", top_name, "with revenue", top_rev)
print("number of categories:", rows.length)
