# Functions, closures, and control flow.
# Covers: fn, return, closures, for/while, if/else if/else, break/continue,
#         range, len, arrays, destructuring, compound assignment.

fn square(n):
  return n * n

fn factorial(n):
  acc = 1
  for i in range(1, n + 1):
    acc *= i
  return acc

# A closure: a function that returns a function capturing its environment
fn adder(base):
  fn add(x):
    return base + x
  return add

add10 = adder(10)
print("square(7)    =", square(7))
print("factorial(5) =", factorial(5))
print("add10(5)     =", add10(5))

# while loop with continue and break
fn first_over(values, threshold):
  i = 0
  while i < values.length:
    v = values[i]
    i += 1
    if v <= threshold:
      continue
    return v
  return null

nums = [3, 1, 4, 1, 5, 9, 2, 6]
print("first value > 4:", first_over(nums, 4))

# if / else if / else
fn grade(score):
  if score >= 90:
    return "A"
  else if score >= 75:
    return "B"
  else if score >= 60:
    return "C"
  else:
    return "F"

for s in [95, 80, 65, 40]:
  print("score", s, "->", grade(s))

# Destructuring and iterating an array
a, b, c = [10, 20, 30]
print("destructured:", a, b, c)

total = 0
for x in nums:
  total += x
print("sum(nums) =", total, "| mean =", total / nums.length)
