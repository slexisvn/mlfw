# Function Approximation — learn sin(x)
#
# Loss: MSELoss
# Optimizer: Adam
# Architecture: 4-layer deep MLP

# --- Data ---
x = tensor([
  -3.0, -2.7, -2.4, -2.1, -1.8, -1.5, -1.2, -0.9, -0.6, -0.3,
   0.0,  0.3,  0.6,  0.9,  1.2,  1.5,  1.8,  2.1,  2.4,  2.7
]).reshape([20, 1])
y = sin(x)

loader = DataLoader(TensorDataset(x, y), batch_size=20)

# --- Model ---
model SineNet():
  fc1 = Linear(1, 32)
  fc2 = Linear(32, 32)
  fc3 = Linear(32, 32)
  fc4 = Linear(32, 1)
  loss_fn = MSELoss()

  forward x:
    h = relu(fc1(x))
    h = relu(fc2(h))
    h = relu(fc3(h))
    return fc4(h)

  train batch:
    x, y = batch
    pred = SineNet(x)
    loss = loss_fn(pred, y)
    log("loss", loss, prog_bar=true)
    return loss

  optimizer:
    return Adam(SineNet.parameters(), lr=0.005)

# --- Train ---
net = SineNet()
trainer = Trainer(max_epochs=500, logger=false, enable_checkpointing=false, enable_progress=false)
trainer.fit(net, loader)

# --- Inference ---
pred = net(x)

print("=== Sine Approximation ===")
print("Predictions:", pred)
print("Actual:     ", y)

diff = abs(pred - y)
mae = mean(diff)
print("MAE:", mae)
