surveys = DataFrame(
  region=["US", "US", "US", "US", "US", "US", "US", "US", "US", "US",
          "EU", "EU", "EU", "EU", "EU", "EU", "EU", "EU", "EU", "EU",
          "APAC", "APAC", "APAC", "APAC", "APAC", "APAC", "APAC", "APAC", "APAC", "APAC"],
  score=[7.0, 8.0, 8.0, 9.0, 6.0, 9.0, 8.0, 7.0, 10.0, 8.0,
         5.0, 6.0, 7.0, 6.0, 8.0, 5.0, 7.0, 6.0, 4.0, 7.0,
         8.0, 9.0, 9.0, 7.0, 10.0, 9.0, 8.0, 9.0, 6.0, 9.0]
)

