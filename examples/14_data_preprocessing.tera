
raw = DataFrame(
  age=[25, 40, 35, 50, 28, 33, 45, 60, 29, 38],
  income=[30.0, null, 55.0, 80.0, null, 42.0, 70.0, 90.0, 33.0, 60.0],
  city=["A", "B", "A", "C", "B", "A", "C", "C", "B", "A"],
  plan=["basic", "pro", "basic", "pro", "basic", "pro", "pro", "pro", "basic", "pro"],
)

print("raw rows:", raw.count())
print("=== raw data ===")
raw.show()

clean = raw.filter(col("income").isNotNull())
print("rows after dropping missing income:", clean.count())

features = normalize(clean.select("age", "income").to_tensor())

labels, classes = clean.select("plan").encode("plan")

print("=== ML-ready output ===")
print("feature matrix shape:", features.shape)
print("label vector shape  :", labels.shape)
print("classes:", classes)
print("normalized features:")
print(features)
print("labels:", labels)
