
model MLP():
  fc1 = Linear(16, 64)
  fc2 = Linear(64, 16)
  forward (x: Tensor) -> Tensor:
    return fc2(fc1(x).relu())

net = MLP()
x = randn([8, 16])

print("=== Model ===")
print("eager output:", net(x).shape)

compiled = compile(net, input=x, target=cpu)
print("=== Compile (cpu) ===")
print(compiled)

optimized = compile(net, input=x, target=cpu, fusion=true, scheduling=true, debug=true)
print("=== Compilation trace ===")
trace(optimized)
